{
  "name": "token-factory",
  "displayName": "Token Factory",
  "description": "Code / Cowork agent powered by opencode, preconfigured for FPT AI Factory. Paste your API key and start.",
  "version": "0.8.6",
  "publisher": "FPTAIFACTORY",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/littlebeanhp/token-factory.git"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The agent runs the bundled opencode binary in the workspace folder, so a repository must be trusted first."
    }
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "keywords": [
    "fpt",
    "ai factory",
    "opencode",
    "agent",
    "ai"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tokenFactory",
          "title": "Token Factory",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "tokenFactory": [
        {
          "type": "webview",
          "id": "tokenFactory.panel",
          "name": "Token Factory"
        }
      ]
    },
    "commands": [
      {
        "command": "tokenFactory.openAgent",
        "title": "Token Factory: Open agent",
        "icon": "$(sparkle)"
      },
      {
        "command": "tokenFactory.setApiKey",
        "title": "Token Factory: Set API key"
      },
      {
        "command": "tokenFactory.signOut",
        "title": "Token Factory: Remove API key"
      },
      {
        "command": "tokenFactory.showPaths",
        "title": "Token Factory: Show data paths"
      }
    ],
    "keybindings": [
      {
        "command": "tokenFactory.openAgent",
        "key": "ctrl+escape",
        "mac": "cmd+escape"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "tokenFactory.openAgent",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Token Factory",
      "properties": {
        "tokenFactory.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "vi",
            "id",
            "ms",
            "ja",
            "ko",
            "zh-cn",
            "es",
            "pt-br",
            "ru"
          ],
          "enumDescriptions": [
            "Follow VS Code",
            "English",
            "Tiếng Việt",
            "Bahasa Indonesia",
            "Bahasa Melayu",
            "日本語",
            "한국어",
            "简体中文",
            "Español",
            "Português (Brasil)",
            "Русский"
          ],
          "default": "auto",
          "description": "Language of the Token Factory panel."
        },
        "tokenFactory.model": {
          "type": "string",
          "default": "",
          "description": "Model ID to use. Leave empty for the default model."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "npm run typecheck && node esbuild.mjs --production",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.0",
    "tar": "^7.5.0",
    "typescript": "^5.9.0"
  }
}
